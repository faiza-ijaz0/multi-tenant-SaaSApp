# Supabase (SignalBoard Development project)
# Public, safe to expose to the browser: project URL and anon key.
# RLS enforces authorization even with the anon key — never a service-role
# key here, and never a NEXT_PUBLIC_* variable for anything secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Private, server-only. Bypasses RLS entirely — never expose to the browser,
# never prefix with NEXT_PUBLIC_. Used only by lib/supabase/service-role.ts
# for the handful of Auth Admin API operations that structurally require it
# (see that file's header for the exact two call sites).
SUPABASE_SERVICE_ROLE_KEY=
